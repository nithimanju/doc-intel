EMBEDDING_MODEL_NAME=google/embeddinggemma-300m
LOG_FILE=logs/doc-intel.log
CHUNK_MAX_TOKEN_LIMIT=2000

# Gated model access — required for EmbeddingGemma tokenizer/weights.
# 1. Accept the licence: https://huggingface.co/google/embeddinggemma-300m
# 2. Create a token: https://huggingface.co/settings/tokens
# 3. Paste it here (never commit .env)
HF_TOKEN=

# Docling conversion
DOCLING_IS_VLM=false
DOCLING_VLM_PRESET=granite_docling
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_DO_CELL_MATCHING=true
DOCLING_IS_TESSERACT=true
DOCLING_OCR_CPU_ONLY=false
DOCLING_DO_HEADING_HIERARCHY=true
DOCLING_PDF_BACKEND=pypdfium2

INDEX_VERSION_ID=
