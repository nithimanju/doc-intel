# Embedding configuration
EMBEDDING_NAME=microsoft/harrier-oss-v1-270m
EMBEDDING_VERSION=31de22b673913c7d658c0f03f792d77c2dcf8ebd
EMBEDDING_MODEL_NAME=microsoft/harrier-oss-v1-270m
EMBEDDING_MODEL_REVISION=31de22b673913c7d658c0f03f792d77c2dcf8ebd
EMBEDDING_BATCH_SIZE=32
# Placeholder, not measured — see settings.py / decisions.md [2026-10-29]
EMBEDDING_DIMENSION=640
IS_EMBEDDING_NORMALIZE=true
IS_EMBEDDING_TRUNCATE=false
EMBEDDING_BASE_URL=http://embed:80

# Huggingface token
HF_TOKEN=

# Parser configuration
PARSER_NAME=docling_parser
PARSER_VERSION=2.143.0
DOCLING_IS_VLM=false
DOCLING_VLM_PRESET=granite_docling
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_DO_CELL_MATCHING=true
DOCLING_IS_TESSERACT=false
DOCLING_OCR_CPU_ONLY=false
DOCLING_DO_HEADING_HIERARCHY=true
DOCLING_PDF_BACKEND=pypdfium2

# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_BATCH_SIZE=2000

# Chunker configuration
CHUNK_MAX_TOKEN_LIMIT=2000
CHUNK_NAME=docling_hybrid_chunker
CHUNKER_VERSION=0.1

# Index configuration
INDEX_VERSION_ID=

# Logging configuration
LOG_FILE=logs/doc-intel.log
